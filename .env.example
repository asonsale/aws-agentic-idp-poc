# Copy to .env and fill in with values from `infra/provision.sh` output
# and `aws iam create-access-key`. Never commit the real .env file.

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# From provision.sh output
S3_BUCKET=
SQS_QUEUE_URL=
RDS_ENDPOINT=
RDS_PORT=5432
RDS_DB_NAME=enterprise_db

# The DB user the app connects as -- create this as a dedicated,
# non-superuser role (see README step 2), NOT the RDS master user,
# so PostgreSQL Row-Level Security actually applies.
DB_USER=app_user
DB_PASSWORD=change_me

# Bedrock models -- must have model access granted in the console first
MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
EMBED_DIMENSIONS=1024

# Internal service hostnames -- defaults match docker-compose.yml service
# names, only change these if you rename services in docker-compose.yml
REDIS_HOST=redis
PRESIDIO_ANALYZER_URL=http://presidio-analyzer:3000/analyze
MCP_SERVER_URL=http://mcp-server:8001/sse
GATEWAY_URL=http://gateway:8000
